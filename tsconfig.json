{
  "include": ["src/**/*.ts"],
  "exclude": ["example", "tests", "dist", "node_modules"],
  "compilerOptions": {
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@proto-gl/*": ["src/*"]
    },
    "target": "ES2019",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
